# 1. DOCKER HUB REGISTRY
DOCKER_USERNAME=your_dockerhub_username

# 2. TOBOMEET SERVER (apps/server)
PORT=3001
CLIENT_URL=https://your-domain.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tobomeet?retryWrites=true&w=majority

# SUPABASE AUTH & DATABASE
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWKS_URL=https://<your-project>.supabase.co/rest/v1/rpc/...
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# CLOUD LIVEKIT
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# REDIS (kết nối container redis trong Docker network)
REDIS_HOST=redis
REDIS_PORT=6379

# CLOUDFLARE R2 STORAGE
R2_BUCKET_NAME=tobomeet-recordings
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_PUBLIC_URL=https://pub-<id>.r2.dev

# WHITEBOARD RS256 KEYS (cho cả server và whiteboard service)
WHITEBOARD_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
WHITEBOARD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI & VECTOR DATABASE
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=tobomeet

