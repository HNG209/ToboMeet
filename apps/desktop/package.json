{
  "name": "desktop",
  "productName": "ToboMeet",
  "version": "0.1.0",
  "description": "ToboMeet Desktop App - Electron wrapper for Next.js",
  "author": "HueVuong",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.tobomeet.app",
    "productName": "ToboMeet",
    "protocols": [
      {
        "name": "ToboMeet Protocol",
        "schemes": [
          "tobomeet"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HNG209",
        "repo": "ToboMeet"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ToboMeet",
      "uninstallDisplayName": "ToboMeet",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "socket.io-client": "^4.8.3"
  }
}
